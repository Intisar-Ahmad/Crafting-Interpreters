### --- C Specifics --- ###
# Compiled Object files
*.o
*.os
*.obj

# Static and Dynamic Libraries
*.a
*.lib
*.so
*.dll
*.dylib

# Executables (Linux usually has no extension, but sometimes .out)
*.out
# If you name your compiled C programs consistently, list them here:
# my_program_name

### --- Java Specifics --- ###
# Compiled class files
*.class

# Log files
*.log

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz

# Virtual Machine crash logs
hs_err_pid*

### --- Build Tools & IDEs --- ###
# CMake (if using for C)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Maven (if using for Java)
target/

# Gradle
.gradle/
build/

# IDEs (VS Code, JetBrains, Eclipse)
.vscode/
.idea/
*.iml
.settings/
.classpath
.project

### --- System Specifics --- ###
# Linux hidden files
.DS_Store
.fuse_hidden*
.directory
.Trash-*